# Sao chép thành .env rồi đổi giá trị. Không commit file .env.
# Tạo secret: openssl rand -base64 48
JWT_SECRET=
POSTGRES_USER=openevent
POSTGRES_PASSWORD=openevent
RABBITMQ_USER=openevent
RABBITMQ_PASSWORD=openevent
# Tài khoản admin đầu tiên, chỉ tạo khi email chưa tồn tại. Mật khẩu 8-72 byte.
BOOTSTRAP_ADMIN_EMAIL=admin@openevent.local
BOOTSTRAP_ADMIN_PASSWORD=
# Để trống thì POST /api/auth/google trả 503.
GOOGLE_CLIENT_ID=
# Các origin của SPA, cách nhau bằng dấu phẩy.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary lưu ảnh bìa sự kiện (Event Service). Để trống thì nút tải ảnh báo "chưa cấu hình", vẫn nhập URL được.
# Lấy ở Cloudinary Console > Settings > API Keys; nên dùng tài khoản hoặc folder riêng cho dev.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# payOS (Payment Service): tiền chuyển khoản VietQR vào tài khoản ngân hàng đã liên kết ở my.payos.vn.
# Lấy Client ID, API Key, Checksum Key ở kênh thanh toán trên my.payos.vn. Có đủ 3 khóa thì payOS được ưu tiên.
# payOS KHÔNG có sandbox: thử bằng số tiền nhỏ. Webhook: khai báo https://<domain công khai>/api/payments/payos-webhook
# ở my.payos.vn; chạy ở máy cá nhân thì không cần, trang kết quả tự hỏi lại payOS.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# VNPay sandbox (Payment Service). Để trống thì dùng cổng giả lập: trang /payments/{id}/mock của SPA.
# Đăng ký tại sandbox.vnpayment.vn; VNPAY_RETURN_URL là địa chỉ Gateway mà trình duyệt người dùng truy cập được.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8080/api/payments/vnpay-return
# SPA: sau khi thanh toán, trình duyệt được chuyển về <FRONTEND_URL>/payments/result.
FRONTEND_URL=http://localhost:5173

# Email của Notification Service (vé kèm QR, báo hủy sự kiện). Để trống MAIL_HOST thì không gửi email,
# thông báo vẫn được lưu. Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME là địa chỉ Gmail,
# MAIL_PASSWORD là App password (Google Account > Security > 2-Step Verification > App passwords), không phải mật khẩu Gmail.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Trống thì gửi bằng MAIL_USERNAME.
MAIL_FROM=

# Chỉ dùng khi deploy (docker-compose.prod.yml). Trên máy chủ đặt thêm:
#   SITE_ADDRESS=<ip-nối-bằng-gạch>.sslip.io   (Caddy tự lấy HTTPS cho tên này)
#   FRONTEND_URL, CORS_ALLOWED_ORIGINS = https://<SITE_ADDRESS>
#   VNPAY_RETURN_URL = https://<SITE_ADDRESS>/api/payments/vnpay-return
# SITE_ADDRESS=
